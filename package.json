{
  "name": "adnankavak-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Academic portfolio of Prof. Dr. Adnan Kavak, Kocaeli University",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next build && npx --yes serve@14 out",
    "preview": "npx --yes serve@14 out",
    "typecheck": "tsc --noEmit",
    "data:publications": "python3 scripts/parse_cv.py scripts/cv_clean.txt data/publications.json",
    "cv": "python3 scripts/gen_cv_publications.py && cd CV/adnan-kavak && tectonic cv.tex && mv cv.pdf ../../public/files/Adnan-Kavak-CV.pdf"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "next": "^15.5.29",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
